# Jira Cloud Configuration (Generic Template)
# Copy this file to .env for local testing (NEVER commit .env to GitHub!)

# Required:
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here

# Choose ONE or more of the following query options:
# Option 1: By Jira Board ID (e.g., from board URL /boards/123)
JIRA_BOARD_ID=123

# Option 2: By Project Key (e.g., PROJ)
JIRA_PROJECT_KEY=PROJ

# Option 3: Custom JQL Query (overrides default ordering / filtering)
# JIRA_JQL=project = "PROJ" AND status != "Cancelled" ORDER BY Rank ASC

# Optional Custom Dashboard Title:
SITE_TITLE=Project Roadmap & Sprint Board
